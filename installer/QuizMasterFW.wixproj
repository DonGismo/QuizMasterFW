<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- Wird von installer/build.ps1 aufgerufen (setzt ProductVersion und StageDir). -->
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <StageDir Condition="'$(StageDir)' == ''">$(MSBuildThisFileDirectory)stage</StageDir>
    <OutputName>QuizMasterFW-$(ProductVersion)</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>de-DE</Cultures>
    <DefineConstants>ProductVersion=$(ProductVersion);StageDir=$(StageDir);AssetsDir=$(MSBuildThisFileDirectory)assets</DefineConstants>
    <OutputPath>$(MSBuildThisFileDirectory)out\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)obj\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Firewall.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>

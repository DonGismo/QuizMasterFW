<?xml version="1.0" encoding="utf-8"?>
<!-- Eigener Installer-Dialog: fragt, ob Port 3000 in der Windows-Firewall freigegeben werden soll. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI>
      <Dialog Id="FirewallDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="290" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Windows-Firewall" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Sollen die Handys im WLAN auf QuizMaster FW zugreifen dürfen?" />

        <Control Id="Erklaerung" Type="Text" X="20" Y="56" Width="330" Height="52" NoPrefix="yes"
                 Text="Die Teilnehmer öffnen das Quiz im Browser ihres Handys. Dafür muss dieser Rechner Verbindungen auf Port 3000 aus dem lokalen Netzwerk annehmen. Standardmäßig blockiert die Windows-Firewall solche Verbindungen." />

        <Control Id="FirewallCheck" Type="CheckBox" X="20" Y="114" Width="330" Height="28" Property="FIREWALL" CheckBoxValue="1"
                 Text="Ja, Port 3000 (TCP) in der Windows-Firewall freigeben (empfohlen)" />

        <Control Id="Details" Type="Text" X="20" Y="148" Width="330" Height="80" NoPrefix="yes"
                 Text="Die Freigabe gilt nur für Geräte im selben lokalen Netz (Subnetz) und nur im Netzwerkprofil „Privat“ – nicht in öffentlichen Netzen. Sie wird bei der Deinstallation automatisch entfernt. Ohne Freigabe funktioniert QuizMaster FW nur auf diesem Rechner; die Freigabe kann später durch erneutes Installieren nachgeholt werden." />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
